<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-gray-900 antialiased">
  <%- include('partials/header') %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <div class="flex gap-4 mb-6">
          <img src="<%= room.image %>" alt="<%= room.title %>" class="w-full h-96 object-cover rounded-xl" loading="lazy">
        </div>
        <h1 class="text-4xl font-serif italic text-gray-900 mb-4"><%= room.title %></h1>
        <div class="flex items-center gap-4 mb-6">
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <%= room.rating %>
          </span>
          <span><%= room.beds %> Bed(s)</span>
          <span><%= room.capacity %> Guests</span>
        </div>
        <p class="text-gray-600 mb-8">Stunning accommodations with premium amenities. Experience luxury and comfort in the heart of the destination.</p>

        <!-- 360 View Button -->
        <button onclick="open360Modal()" class="px-6 py-3 border-2 border-coral text-coral font-semibold rounded-lg hover:bg-coral hover:text-white transition-colors flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          360° Virtual Tour
        </button>

        <!-- Local Attractions -->
        <section class="mt-16">
          <h2 class="text-3xl font-serif italic text-gray-900 mb-6">Top 5 Things to Do Nearby</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% attractions.slice(0,5).forEach((att) => { %>
            <div class="flex gap-4 bg-gray-50 rounded-xl p-4">
              <img src="<%= att.image %>" alt="<%= att.title %>" class="w-24 h-24 object-cover rounded-lg" loading="lazy">
              <div>
                <h3 class="font-semibold text-gray-900"><%= att.title %></h3>
                <p class="text-sm text-gray-600 mt-1"><%= att.description %></p>
                <p class="text-xs text-coral mt-2"><%= att.distance %> away</p>
              </div>
            </div>
            <% }) %>
          </div>
        </section>
      </div>

      <!-- Sticky Quick Book Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24 bg-white border border-gray-200 rounded-xl shadow-lg p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Quick Book</h3>
          <p class="text-2xl font-bold text-coral mb-4">$<%= room.price %><span class="text-sm font-normal text-gray-500">/night</span></p>
          
          <form id="quickBookForm" action="/api/book" method="POST" class="space-y-4">
            <input type="hidden" name="roomId" value="<%= room.id %>">
            <input type="hidden" name="total" id="totalInput" value="<%= room.price %>">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Check In</label>
              <input type="date" name="checkIn" id="quickCheckIn" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Check Out</label>
              <input type="date" name="checkOut" id="quickCheckOut" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Guests</label>
              <select name="guests" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral">
                <% for(let g=1; g<=6; g++) { %>
                <option value="<%= g %>"><%= g %> Guest<%= g>1?'s':'' %></option>
                <% } %>
              </select>
            </div>
            <p class="text-gray-600">Total: $<span id="dynamicTotal"><%= room.price %></span></p>
            <button type="submit" class="w-full py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coralDark transition-colors">Book Now</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- 360 View Modal -->
  <div id="modal360" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4" onclick="if(event.target===this)close360Modal()">
    <div class="bg-white rounded-xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
      <div class="flex justify-between items-center p-4 border-b">
        <h3 class="text-xl font-semibold">360° Virtual Tour</h3>
        <button onclick="close360Modal()" class="text-gray-600 hover:text-gray-900 text-2xl">&times;</button>
      </div>
      <div class="p-4">
        <img src="<%= room.image %>" alt="Panoramic view" class="w-full rounded-lg" style="max-height:70vh;object-fit:contain">
        <p class="text-center text-gray-500 mt-2">Panoramic room view (placeholder)</p>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    const pricePerNight = <%= room.price %>;
    function calcDays() {
      const ci = document.getElementById('quickCheckIn')?.value;
      const co = document.getElementById('quickCheckOut')?.value;
      if (!ci || !co) return pricePerNight;
      const a = new Date(ci), b = new Date(co);
      const days = Math.ceil((b - a) / (1000*60*60*24));
      return Math.max(1, days) * pricePerNight;
    }
    function updateTotal() {
      const total = calcDays();
      const el = document.getElementById('dynamicTotal');
      const inp = document.getElementById('totalInput');
      if (el) el.textContent = total;
      if (inp) inp.value = total;
    }
    document.getElementById('quickCheckIn')?.addEventListener('change', updateTotal);
    document.getElementById('quickCheckOut')?.addEventListener('change', updateTotal);

    function open360Modal() {
      document.getElementById('modal360').classList.remove('hidden');
      document.getElementById('modal360').classList.add('flex');
    }
    function close360Modal() {
      document.getElementById('modal360').classList.add('hidden');
      document.getElementById('modal360').classList.remove('flex');
    }

    document.getElementById('quickBookForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const data = Object.fromEntries(formData);
      const res = await fetch('/api/book', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      const json = await res.json();
      if (json.redirectUrl) window.location.href = json.redirectUrl;
    });
  </script>
</body>
</html>
