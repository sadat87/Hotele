<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-gray-900 antialiased">
  <%- include('partials/header') %>

  <section class="py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-serif italic text-gray-900 mb-8">My Profile</h1>
      <div class="bg-gray-50 rounded-xl p-8 space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Name</label>
          <input type="text" value="Guest User" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <input type="email" value="guest@example.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral">
        </div>
        <button class="px-8 py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coralDark transition-colors">Save Changes</button>
      </div>
      <h2 class="text-2xl font-semibold mt-12 mb-4">My Bookings</h2>
      <p class="text-gray-600">No bookings yet. <a href="/rooms" class="text-coral hover:underline">Browse rooms</a></p>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
